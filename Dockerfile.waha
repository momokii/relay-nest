FROM devlikeapro/waha:latest-2026.10.1@sha256:2fc1787ddbd343ed2e7d59482846d1b22aa5ca134e29aa8d42d0e88c54e24779

ARG VERSION=1.0.0
ARG GIT_SHA=dev
ARG BUILD_DATE
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$GIT_SHA org.opencontainers.image.created=$BUILD_DATE org.opencontainers.image.title="RelayNest" org.opencontainers.image.source="https://github.com/momokii/relay-nest"

COPY docker/waha-entrypoint.sh /usr/local/bin/relaynest-waha-entrypoint.sh

ENTRYPOINT ["/bin/sh", "/usr/local/bin/relaynest-waha-entrypoint.sh"]
