{
  "name": "@waha-command-center/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@waha-command-center/config": "workspace:*",
    "@waha-command-center/domain": "workspace:*",
    "@waha-command-center/waha-contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "postgres": "3.4.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "esbuild": "0.25.12",
    "tsx": "4.19.4"
  }
}
