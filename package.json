{
  "name": "waha-command-center",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @waha-command-center/api db:generate",
    "db:migrate": "pnpm --filter @waha-command-center/api db:migrate",
    "dev": "pnpm --parallel --filter @waha-command-center/api --filter @waha-command-center/web dev",
    "e2e": "playwright test",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@playwright/test": "1.55.1",
    "@types/node": "22.15.21",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
