# Safe placeholders only; inject real values through an environment-specific secret store.
APP_ENV=development
WEB_PORT=8080
# Keep loopback for local/reverse-proxy use; set an explicit trusted LAN/VPN address when required.
WEB_BIND_ADDRESS=127.0.0.1
WAHA_BASE_URL=https://waha.example.invalid
# Uncomment exactly one encryption key source; never activate both.
# Compose reads the encryption key from this Docker secret file; do not put key material in the path.
# ENCRYPTION_MASTER_KEY_FILE=.secrets/encryption_master_key
# Non-Compose API and test commands may use this safe development placeholder instead.
# ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Non-Compose API and Drizzle commands may use one validated PostgreSQL URL.
# DATABASE_URL=postgresql://app:replace-me@postgres:5432/waha_command_center
# Compose instead supplies DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER,
# and DATABASE_PASSWORD_FILE from the postgres_password Docker secret.
POSTGRES_PASSWORD_FILE=.secrets/postgres_password
# Bundled WAHA reads its API key through the RelayNest wrapper from this Docker
# secret file; do not put WAHA_API_KEY material in this environment file.
# WAHA_API_KEY_FILE=.secrets/waha_api_key
